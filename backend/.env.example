# Flask (Azure VM)
FLASK_CONFIG=production
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
SECRET_KEY=change-me-in-production

# SQLite by default; use Postgres on Azure if you prefer
# DATABASE_URL=postgresql://user:pass@host:5432/hirefast

# Comma-separated origins allowed to call the API (for direct browser → Flask).
# Include your Vercel URL when using NEXT_PUBLIC_API_URL (rare). Proxy mode does not need this for same-origin.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-app.vercel.app
# Base URL for external callbacks (VM IP/domain). Reuse for LinkedIn + Composio.
APP_BASE_URL=http://127.0.0.1:5000

# AI (required for JD generation / scoring)
GROQ_API_KEY=

# LinkedIn OAuth — in Developer Portal: app → Auth → OAuth 2.0 → Authorized redirect URLs
# Add EXACTLY one line (must match APP_BASE_URL): http://YOUR_HOST:5000/callback
# Example VM: http://40.82.143.50:5000/callback — http vs https, host, port, and path must match
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Composio (Google Calendar via /connect-calendar)
COMPOSIO_API_KEY=
# Auth Config ID from Composio dashboard for Google Calendar OAuth
COMPOSIO_GOOGLE_CALENDAR_AUTH_CONFIG_ID=
# Optional: override pinned Google Calendar toolkit version (default in code: 20260324_00)
# COMPOSIO_TOOLKIT_VERSION_GOOGLECALENDAR=20260324_00
# Optional: set true only if you must bypass version checks (not recommended)
# COMPOSIO_DANGEROUSLY_SKIP_TOOLKIT_VERSION_CHECK=false
# Google Calendar OAuth return path: {APP_BASE_URL}/scheduling (set APP_BASE_URL above)
